# Supabase (server only; RLS is enabled with no policies, so only this key can read or write)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Gemini via the Vercel AI SDK. Use a BILLED API key (not the AI Studio free tier).
GOOGLE_GENERATIVE_AI_API_KEY=""
# The single model used for every AI step. There is no default and no fallback.
AI_MODEL="gemini-3.8-flash"

# Resend. The sender must be on a domain verified in Resend that can deliver to the MESA test addresses.
RESEND_API_KEY=""
EMAIL_FROM="Kargo Hiring <hiring@your-verified-domain.example>"

# Optional TEST MODE. When set, every email is delivered to this MESA address instead of the
# candidate's, with "[TEST]" in the subject. Needed while Resend has no verified domain, because
# a Resend account without one can only deliver to its owner's own address. Leave unset for real use.
# EMAIL_TEST_RECIPIENT="you@pg27.mesaschool.co"

# --- Optional: only used by scripts/ and tests/, never by the app ---
# BASE_URL="http://localhost:3000"   # server the integration tests talk to
# CV_DIR="/path/to/folder/of/cv/pdfs" # folder of CV PDFs for scripts/deid-check.ts and tests/integration
# NO_HINTS=1                          # scripts/deid-check.ts only: ignore filename and PDF metadata
# TEST_RECIPIENT=you@pg27.mesaschool.co # tests/integration/send-self.ts only: a MESA address Resend may deliver to
# ALLOW_WIPE=1                       # tests/integration/three.ts and all60.ts only: allow them to DELETE ALL CANDIDATES
